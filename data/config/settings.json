{
  "app_name": "TravelPlan",
  "base_currencies": ["USD", "EUR", "GBP", "JPY", "CNY", "KRW", "AUD", "CAD", "SGD", "THB", "HKD", "TWD"],
  "item_types": {
    "hotel": {
      "label": "Hotel",
      "icon": "bed",
      "spans_days": true,
      "when_labels": {
        "start": "Check-in",
        "end": "Check-out"
      },
      "fields": [
        {"key": "hotel_name", "label": "Hotel name", "type": "text"},
        {"key": "address", "label": "Address", "type": "text"},
        {"key": "booking_ref", "label": "Booking ref", "type": "text"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["hotel_name", "booking_ref"],
        ["address"],
        ["note"]
      ]
    },
    "transit": {
      "label": "Transit",
      "icon": "plane",
      "spans_days": false,
      "when_labels": {
        "start": "Depart",
        "end": "Arrive"
      },
      "fields": [
        {"key": "mode", "label": "Type", "type": "select", "options": ["Flight", "Train", "Bus", "Ferry", "Taxi", "Rental car"]},
        {"key": "provider", "label": "Provider / airline", "type": "text"},
        {"key": "ref_no", "label": "Ref / flight no.", "type": "text"},
        {"key": "from", "label": "From", "type": "text"},
        {"key": "to", "label": "To", "type": "text"},
        {"key": "seat", "label": "Seat / car", "type": "text"},
        {"key": "confirmation", "label": "Confirmation", "type": "text"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["mode", "provider"],
        ["ref_no", "confirmation"],
        ["from", "to"],
        ["seat"],
        ["note"]
      ]
    },
    "activity": {
      "label": "Activity",
      "icon": "compass",
      "spans_days": false,
      "when_labels": {
        "start": "Start",
        "end": "End"
      },
      "fields": [
        {"key": "name", "label": "Name", "type": "text"},
        {"key": "location", "label": "Location / Venue", "type": "text"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["name", "location"],
        ["note"]
      ]
    },
    "restaurant": {
      "label": "Restaurant",
      "icon": "restaurant",
      "spans_days": false,
      "when_labels": {
        "start": "Time",
        "end": "End"
      },
      "fields": [
        {"key": "name", "label": "Restaurant name", "type": "text"},
        {"key": "address", "label": "Address", "type": "text"},
        {"key": "party_size", "label": "Party size", "type": "number"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["name", "party_size"],
        ["address"],
        ["note"]
      ]
    },
    "note": {
      "label": "Note",
      "icon": "note",
      "spans_days": false,
      "when_labels": {
        "start": "At",
        "end": "Until"
      },
      "fields": [
        {"key": "text", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["text"]
      ]
    }
  }
}
