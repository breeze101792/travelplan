{
  "app_name": "TravelPlan",
  "base_currencies": ["USD", "EUR", "GBP", "JPY", "CNY", "KRW", "AUD", "CAD", "SGD", "THB", "HKD", "TWD"],
  "item_types": {
    "hotel": {
      "label": "Hotel",
      "icon": "bed",
      "spans_days": true,
      "fields": [
        {"key": "hotel_name", "label": "Hotel name", "type": "text"},
        {"key": "address", "label": "Address", "type": "text"},
        {"key": "check_in_time", "label": "Check-in", "type": "time"},
        {"key": "check_out_time", "label": "Check-out", "type": "time"},
        {"key": "booking_ref", "label": "Booking ref", "type": "text"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["hotel_name", "booking_ref"],
        ["check_in_time", "check_out_time"],
        ["address"],
        ["note"]
      ]
    },
    "transit": {
      "label": "Transit",
      "icon": "plane",
      "spans_days": false,
      "fields": [
        {"key": "mode", "label": "Mode", "type": "select", "options": ["Flight", "Train", "Bus", "Ferry", "Taxi", "Rental car"]},
        {"key": "provider", "label": "Provider / airline", "type": "text"},
        {"key": "ref_no", "label": "Ref / flight no.", "type": "text"},
        {"key": "from", "label": "From", "type": "text"},
        {"key": "to", "label": "To", "type": "text"},
        {"key": "depart_time", "label": "Depart", "type": "datetime-local"},
        {"key": "arrive_time", "label": "Arrive", "type": "datetime-local"},
        {"key": "seat", "label": "Seat / car", "type": "text"},
        {"key": "confirmation", "label": "Confirmation", "type": "text"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["mode", "provider"],
        ["ref_no", "confirmation"],
        ["from", "to"],
        ["depart_time", "arrive_time"],
        ["seat"],
        ["note"]
      ]
    },
    "ticket": {
      "label": "Ticket",
      "icon": "ticket",
      "spans_days": false,
      "fields": [
        {"key": "name", "label": "Name", "type": "text"},
        {"key": "venue", "label": "Venue", "type": "text"},
        {"key": "start_time", "label": "Start", "type": "datetime-local"},
        {"key": "end_time", "label": "End", "type": "datetime-local"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["name", "venue"],
        ["start_time", "end_time"],
        ["note"]
      ]
    },
    "restaurant": {
      "label": "Restaurant",
      "icon": "utensils",
      "spans_days": false,
      "fields": [
        {"key": "name", "label": "Name", "type": "text"},
        {"key": "address", "label": "Address", "type": "text"},
        {"key": "start_time", "label": "Start", "type": "datetime-local"},
        {"key": "end_time", "label": "End", "type": "datetime-local"},
        {"key": "party_size", "label": "Party size", "type": "number"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["name", "party_size"],
        ["start_time", "end_time"],
        ["address"],
        ["note"]
      ]
    },
    "activity": {
      "label": "Activity",
      "icon": "compass",
      "spans_days": false,
      "fields": [
        {"key": "name", "label": "Name", "type": "text"},
        {"key": "location", "label": "Location", "type": "text"},
        {"key": "start_time", "label": "Start", "type": "datetime-local"},
        {"key": "end_time", "label": "End", "type": "datetime-local"},
        {"key": "note", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["name", "location"],
        ["start_time", "end_time"],
        ["note"]
      ]
    },
    "note": {
      "label": "Note",
      "icon": "note",
      "spans_days": false,
      "fields": [
        {"key": "text", "label": "Note", "type": "textarea"}
      ],
      "rows": [
        ["text"]
      ]
    }
  }
}